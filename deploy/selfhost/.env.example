# Legion Hub settings for this machine. install.sh / install.ps1 copy this file
# to .env and fill in the three marked blocks; to do it by hand, replace every
# "change-me" with a long random value (`openssl rand -hex 32`).
#
# Settings that apply to every user of the Hub (limits, who may register,
# MCP servers installed for the owner) live in config/legion.toml.
# See docs/CONFIGURATION.md for every key.

# ── Version ────────────────────────────────────────────────────────────────
# The release to run (a tag such as v0.1.0). `latest` is the newest release.
LEGION_VERSION=latest

# ── Secrets: generated by the installer, never share or commit them ────────
POSTGRES_PASSWORD=change-me
# Signs login sessions. Changing it signs everybody out.
SECRET_KEY=change-me
# The Hub talks to its helper services with these. Each is a separate secret.
WORKSPACED_TOKEN=change-me
MCP_HOST_TOKEN=change-me
MCP_GATEWAY_TOKEN=change-me

# ── Address ────────────────────────────────────────────────────────────────
# The address you type into the browser. Used for sign-in redirects and links,
# so it must be exact (scheme, host, port).
HUB_PUBLIC_URL=http://localhost:8080
# Where the Hub listens on this machine. 127.0.0.1 keeps it private; use
# 0.0.0.0 to reach it from other devices in your network.
LEGION_BIND=127.0.0.1
LEGION_PORT=8080

# Your own domain with HTTPS (docker compose --profile caddy up -d). Set
# HUB_PUBLIC_URL=https://<domain> too, and LEGION_BIND=127.0.0.1.
# HUB_DOMAIN=hub.example.com

# ── Who may register ───────────────────────────────────────────────────────
# closed (default): the first person to register becomes the owner, nobody
# else can. invite: the owner creates invitations. open: anyone with the
# address. Overrides [registration] mode in config/legion.toml.
# LEGION_REGISTRATION=closed

# ── What this machine can hold, all users together ─────────────────────────
# Overrides [capacity] in config/legion.toml. Empty or unset: the file decides
# (no cap by default). See docs/CONFIGURATION.md.
# LEGION_CAPACITY_MAX_WORKSPACES=3
# LEGION_CAPACITY_MEMORY_MB=3072

# ── Per-user limits ────────────────────────────────────────────────────────
# Overrides [limits] in config/legion.toml; empty or unset: the file decides.
# Every key of [limits] works as LEGION_LIMIT_<KEY>, see docs/CONFIGURATION.md.
# LEGION_LIMIT_MAX_RUNNING=8
# LEGION_LIMIT_MAX_ROOMS=20

# ── LLM providers (optional) ───────────────────────────────────────────────
# Each user can also add provider keys in Settings; keys set here are the
# fallback for everybody.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# ── Web search for agents (optional) ───────────────────────────────────────
# A key for the built-in web_search tool: Brave Search or Tavily, billed to you.
# Other ways to give agents search are in docs/SEARCH.md.
# WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=

# ── Advanced ───────────────────────────────────────────────────────────────
# Docker socket the helpers use. Default works for Linux, Docker Desktop on
# Windows and Docker Desktop on macOS. Rootless Docker or Colima: set the path
# of your socket (see docs/INSTALL.md).
# DOCKER_SOCKET=/var/run/docker.sock
# Show a different "source code" link (for a modified Hub, AGPL section 13).
# LEGION_SOURCE_URL=https://github.com/MyLegionOnline/legion-hub
# Allow MCP links over plain http:// (for a server on your own network). Off
# by default: the gateway refuses non-HTTPS and private addresses.
# MCP_GATEWAY_REQUIRE_HTTPS=true
