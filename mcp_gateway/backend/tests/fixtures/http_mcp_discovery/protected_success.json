        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/list",
          "params": {}
        },
        "response": {
          "status": 200,
          "body": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "tools": [
                {
                  "name": "get_commit",
                  "description": "Read a commit by repository and SHA.",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "repository": {"type": "string"},
                      "sha": {"type": "string"}
                    },
                    "required": ["repository", "sha"]
                  }
                }
              ]
            }
          }
        }
      }
    ]
  },
  "expected": {
    "status_code": 200,
    "response": {
      "installed_item_id": "00000000-0000-0000-0000-000000000042",
      "status": "verified",
      "tools": [
        {
          "name": "get_commit",
