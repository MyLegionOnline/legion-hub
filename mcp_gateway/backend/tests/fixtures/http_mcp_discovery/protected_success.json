            "clientInfo": {
              "name": "legion-mcp-gateway",
              "version": "0.1.0"
            }
          }
        },
        "response": {
          "status": 200,
          "headers": {"mcp-session-id": "fixture-session-001"},
          "body": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "2025-03-26",
              "capabilities": {"tools": {}},
              "serverInfo": {"name": "fixture-github", "version": "1.0.0"}
            }
          }
        }
      },
      {
        "method": "tools/list",
