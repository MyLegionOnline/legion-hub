{
  "contract": "http-mcp-discovery.v1",
  "case": "protected_success",
  "request": {
    "headers": {
      "Authorization": "Bearer <gateway-token>",
      "X-Legion-MCP-Upstream-Authorization": "Bearer <fixture-upstream-token>"
    },
    "body": {
      "installed_item_id": "00000000-0000-0000-0000-000000000042",
      "market_item_id": null,
      "market_slug": null,
      "custom_config": {
        "url": "https://mcp.example.test/github/readonly",
        "auth": {"mode": "bearer"}
      }
    }
  },
  "upstream": {
    "frames": [
      {
        "method": "initialize",
        "headers": {
          "authorization": "Bearer <fixture-upstream-token>",
          "content-type": "application/json",
          "accept": "application/json, text/event-stream"
        },
        "body": {
          "jsonrpc": "2.0",
